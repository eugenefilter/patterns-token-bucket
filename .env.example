# Copy to .env for local settings. Real environment variables take priority over this file.

# Limiter
RATELIMIT_CAPACITY=10
RATELIMIT_REFILL_RATE=1

# Where the state lives: memory | redis
RATELIMIT_BACKEND=memory
RATELIMIT_REDIS_URL=redis://localhost:6379/0

# Redis database for tests and scripts/race_demo.py.
# Keep it separate from real data.
RATELIMIT_TEST_REDIS_URL=redis://localhost:6379/15
